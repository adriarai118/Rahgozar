{
  "manifest_version": 3,
  "name": "Rahgozar — رهگذر",
  "short_name": "Rahgozar",
  "version": "1.1.0",
  "description": "کنترل فیلترشکن رهگذر از داخل مرورگر: اتصال، انتخاب سرور و تعیین مسیر هر سایت (تونل / مستقیم / مسدود).",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "رهگذر",
    "default_icon": { "16": "icons/icon16-off.png", "32": "icons/icon32-off.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "permissions": ["storage", "tabs", "contextMenus", "proxy", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "commands": {
    "toggle-connection": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "اتصال / قطع رهگذر"
    },
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "این سایت: جابه‌جایی بین تونل و مستقیم"
    }
  }
}
